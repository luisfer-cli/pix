canvas 32 32
background transparent
strict_palette true

palette {
    O #111827
    D #0f3d3e
    B #146c72
    M #22d3ee
    H #a7f3ff
    P #f472b6
    Y #facc15
    SH #00000055
}

group shadow at 6 28 {
    rect 0 0 20 2 SH
    rect 4 2 12 1 SH
}

group tail at 4 16 {
    line 0 8 5 5 O
    line 1 7 6 4 B
    line 6 4 10 6 B
    line 10 6 14 3 M
    pixel 13 2 H
}

group wing_back at 7 6 {
    line 6 9 2 1 O
    line 6 9 12 2 O
    line 3 2 5 12 D
    line 11 3 9 12 D
    rect 5 7 4 3 B
    pixel 6 5 M
    pixel 9 6 M
}

group body at 9 12 {
    rect 2 4 13 8 O
    rect 3 3 11 9 B
    rect 5 2 7 9 M
    rect 5 10 8 2 D
    pixel 8 4 H
    pixel 10 5 H
    line 4 12 2 17 O
    line 12 12 15 17 O
    rect 1 17 5 2 D
    rect 13 17 5 2 D
}

group head at 17 7 {
    rect 0 4 10 8 O
    rect 1 3 8 8 B
    rect 3 2 5 7 M
    line 1 3 0 0 O
    line 7 3 10 0 O
    pixel 0 0 Y
    pixel 10 0 Y
    rect 6 5 2 2 P
    pixel 7 5 H
    rect 2 8 5 1 O
    pixel 9 10 H
}

group sparks at 3 4 {
    pixel 0 0 P
    pixel 25 2 H
    pixel 23 7 Y
    pixel 1 15 M
    pixel 27 18 P
}
