canvas 32 32
background transparent
strict_palette true

palette {
    O #111827
    D #991b1b
    R #ef4444
    P #fb7185
    H #fecdd3
}

frame beat-1 {
    group heart at 5 5 {
        rect 4 0 6 3 O
        rect 13 0 6 3 O
        rect 2 3 20 10 O
        rect 4 13 16 5 O
        rect 7 18 10 4 O
        rect 10 22 4 2 O
        rect 5 1 4 2 P
        rect 14 1 4 2 R
        rect 3 4 18 8 R
        rect 5 12 14 4 D
        rect 8 16 8 4 D
        rect 7 4 4 2 H
    }
}

frame beat-2 {
    group heart at 3 3 {
        rect 5 0 7 3 O
        rect 15 0 7 3 O
        rect 2 3 23 11 O
        rect 4 14 19 5 O
        rect 8 19 11 4 O
        rect 11 23 5 3 O
        rect 6 1 5 2 P
        rect 16 1 5 2 R
        rect 3 4 21 9 R
        rect 5 13 17 4 D
        rect 9 17 9 4 D
        rect 8 4 5 2 H
    }
}

animation beat fps 4 {
    beat-1
    beat-2
    beat-1
    beat-2
}
