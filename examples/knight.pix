canvas 32 32
background transparent
strict_palette true

palette {
    O #181425
    S #f6c09c
    D #c97972
    A #3b5dc9
    L #73eff7
    W #ffffff
}

group head at 12 5 {
    rect 0 1 8 7 S
    rect 0 0 8 2 O
    pixel 2 4 O
    pixel 3 4 W
    pixel 5 4 O
    pixel 6 4 W
    rect 1 7 6 1 D
}

group torso at 10 13 {
    rect 0 0 12 10 A
    rect 1 1 10 2 L
    line 0 0 11 0 O
    line 0 9 11 9 O
    pixel 5 4 O
    pixel 6 4 O
}

group legs at 11 23 {
    rect 0 0 4 6 A
    rect 7 0 4 6 A
    pixel 0 6 O
    pixel 10 6 O
}
