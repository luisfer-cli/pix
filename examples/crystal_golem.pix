canvas 32 32
background transparent
strict_palette true

palette {
    O #111827
    S #334155
    B #64748b
    C #0891b2
    H #cffafe
}

frame pulse-1 {
    group golem at 5 3 {
        rect 8 0 6 3 O
        rect 6 3 10 7 O
        rect 3 10 16 10 O
        rect 0 12 4 6 O
        rect 18 12 4 6 O
        rect 5 20 5 8 O
        rect 12 20 5 8 O
        rect 9 2 4 5 S
        rect 7 4 8 4 B
        rect 5 11 12 7 S
        rect 4 13 3 4 B
        rect 17 13 3 4 B
        rect 7 12 8 5 B
        rect 9 13 4 4 C
        rect 10 13 2 2 H
        rect 6 21 3 5 S
        rect 13 21 3 5 S
    }
}

frame pulse-2 {
    group golem at 4 2 {
        rect 9 0 6 3 O
        rect 7 3 10 7 O
        rect 3 10 18 11 O
        rect 0 12 4 7 O
        rect 20 12 4 7 O
        rect 6 21 5 8 O
        rect 14 21 5 8 O
        rect 10 2 4 5 S
        rect 8 4 8 4 B
        rect 5 11 14 8 S
        rect 4 13 3 5 B
        rect 19 13 3 5 B
        rect 7 12 10 6 B
        rect 9 12 6 6 C
        rect 10 13 4 3 H
        rect 7 22 3 5 S
        rect 15 22 3 5 S
    }
}

frame pulse-3 {
    group golem at 5 3 {
        rect 8 0 6 3 O
        rect 6 3 10 7 O
        rect 3 10 16 10 O
        rect 0 12 4 6 O
        rect 18 12 4 6 O
        rect 5 20 5 8 O
        rect 12 20 5 8 O
        rect 9 2 4 5 S
        rect 7 4 8 4 B
        rect 5 11 12 7 S
        rect 4 13 3 4 B
        rect 17 13 3 4 B
        rect 7 12 8 5 B
        rect 9 13 4 4 C
        rect 10 13 2 2 H
        rect 6 21 3 5 S
        rect 13 21 3 5 S
    }
}

animation pulse fps 5 {
    pulse-1
    pulse-2
    pulse-3
    pulse-2
}
