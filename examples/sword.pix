canvas 16 16
background transparent
strict_palette true

palette {
    O #181425
    M #c0cbdc
    L #ffffff
    H #f6c177
    B #5d275d
}

group blade at 0 0 {
    line 8 1 8 9 M
    line 9 2 9 8 L
    pixel 8 0 L
    pixel 7 1 O
    pixel 9 1 O
}

group hilt at 0 0 {
    rect 5 10 7 2 H
    rect 7 12 3 3 B
    pixel 7 15 O
    pixel 9 15 O
}
