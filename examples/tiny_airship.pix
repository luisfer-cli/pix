    rect 5 3 16 3 O
    rect 3 6 20 9 O
    rect 5 15 16 3 O
    rect 8 18 10 2 O
    rect 9 3 8 2 B
    rect 6 5 14 2 B
    rect 4 7 18 6 B
    rect 6 13 14 3 D
    rect 9 16 8 2 D
    rect 8 6 4 6 Y
    rect 12 5 3 8 W
    rect 15 6 3 6 Y
    rect 10 20 2 4 O
    rect 17 20 2 4 O
    rect 9 23 11 2 O
    rect 10 24 9 3 S
    rect 11 24 3 2 C
    rect 16 24 2 2 C
    rect 20 24 4 2 O
    rect 23 22 2 6 O
    rect 24 21 2 8 S
}
