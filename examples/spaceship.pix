canvas 32 32
background transparent
strict_palette true

palette {
    O #0b1020
    M #7f8ea3
    L #dce6f2
    B #3b5dc9
    F #ff6b35
    Y #ffd166
}

group body at 8 4 {
    rect 6 4 4 15 M
    rect 7 7 2 4 L
    line 7 0 3 12 M
    line 8 0 12 12 M
    rect 5 13 2 7 B
    rect 10 13 2 7 B
    line 5 18 11 18 O
}

group flame at 14 23 {
    pixel 1 0 Y
    rect 0 1 3 1 F
    pixel 1 2 F
}
